                "classification": "Critical"
            }
        },
        {
            "name": "supercritical_case",
            "nuclear_data": {
                "Synthetic Fuel": {
                    "absorption_cross_section_barns": 2.0,
                    "fission_cross_section_barns": 1.0,
                    "neutrons_per_fission": 3.0
                }
            },
            "number_densities": {
                "Synthetic Fuel": 1e20
            },
            "expected": {
                "multiplication_factor": 1.5,
