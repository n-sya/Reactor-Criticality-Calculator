                    "neutrons_per_fission": 3.0
                },
                "Synthetic Absorber": {
                    "absorption_cross_section_barns": 2.0,
                    "fission_cross_section_barns": 0.0,
                    "neutrons_per_fission": 0.0
                }
            },
            "number_densities": {
                "Synthetic Fuel": 1e20,
                "Synthetic Absorber": 5e19
            },
            "expected": {
                "multiplication_factor": 1.0,
                "total_absorption": 3e-8,
